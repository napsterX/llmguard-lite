# ─────────────────────────────────────────────────────────────
# LLMGuard Lite — local development configuration
#
# Copy this file to .env and fill in the values for your setup.
#   cp .env.example .env
#
# .env is listed in .gitignore and must never be committed.
# ─────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────

# PostgreSQL connection string.
# The schema is created automatically on first startup.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://llmguard:llmguard@localhost:5432/llmguard


# ── Provider API keys ─────────────────────────────────────────

# Anthropic API key — required to proxy requests to Anthropic.
# Leave blank to disable the /v1/proxy/anthropic/messages endpoint.
# Obtain a key from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI API key — required to proxy requests to OpenAI.
# Leave blank to disable the /v1/proxy/openai/chat/completions endpoint.
# Obtain a key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=


# ── Application ───────────────────────────────────────────────

# Display name shown in the auto-generated API docs at /docs.
APP_NAME=LLMGuard Lite

# Enable FastAPI debug mode. Set to true only in local development.
DEBUG=false
